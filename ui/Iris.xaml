<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iris" Width="440" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="#F4EFFA"
        TextOptions.TextFormattingMode="Ideal">

  <Window.Resources>
    <SolidColorBrush x:Key="Cloud" Color="#F4EFFA"/>
    <SolidColorBrush x:Key="Haze" Color="#ADA5CF"/>
    <SolidColorBrush x:Key="Ink" Color="#1B1445"/>
    <SolidColorBrush x:Key="Veil" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="VeilHover" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="Focus" Color="#9D8CFF"/>
    <FontFamily x:Key="Display">Sitka Display, Sitka Heading, Georgia</FontFamily>

    <ControlTemplate x:Key="Face" TargetType="Button">
      <Border x:Name="Edge" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2"
              CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter TargetName="Edge" Property="BorderBrush" Value="{StaticResource Focus}"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.35"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Soft" TargetType="Button">
      <Setter Property="Template" Value="{StaticResource Face}"/>
      <Setter Property="Tag" Value="17"/>
      <Setter Property="Background" Value="{StaticResource Veil}"/>
      <Setter Property="Foreground" Value="{StaticResource Cloud}"/>
      <Setter Property="Padding" Value="14,5"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource VeilHover}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Main" TargetType="Button" BasedOn="{StaticResource Soft}">
      <Setter Property="Tag" Value="14"/>
      <Setter Property="Background" Value="{StaticResource Cloud}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Padding" Value="18,11"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Plain" TargetType="Button" BasedOn="{StaticResource Soft}">
      <Setter Property="Tag" Value="14"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Haze}"/>
      <Setter Property="Padding" Value="18,11"/>
      <Setter Property="FontSize" Value="14"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource Veil}"/>
          <Setter Property="Foreground" Value="{StaticResource Cloud}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Glyph" TargetType="Button" BasedOn="{StaticResource Plain}">
      <Setter Property="Tag" Value="16"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
    </Style>

    <Style x:Key="Tick" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Haze}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" Background="{StaticResource Veil}"
                      BorderBrush="#66ADA5CF" BorderThickness="1.5" VerticalAlignment="Center">
                <Path x:Name="Mark" Data="M3.5,9 L7,12.5 L13.5,5" Stroke="{StaticResource Ink}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Cloud}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Cloud}"/>
                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Cloud}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Focus}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="20" CornerRadius="22">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#33257A" Offset="0"/>
        <GradientStop Color="#1D1650" Offset="0.5"/>
        <GradientStop Color="#120E30" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#05030F"/>
    </Border.Effect>

    <Grid>
      <StackPanel Margin="28,16,28,26">
        <DockPanel Margin="0,0,-10,0">
          <Button x:Name="Close" DockPanel.Dock="Right" Style="{StaticResource Glyph}" ToolTip="Close"
                  AutomationProperties.Name="Close">
            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
          <Button x:Name="Minimize" DockPanel.Dock="Right" Style="{StaticResource Glyph}" ToolTip="Minimize"
                  AutomationProperties.Name="Minimize">
            <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
          <TextBlock Text="Iris" FontFamily="{StaticResource Display}" FontSize="19" VerticalAlignment="Center"
                     Foreground="{StaticResource Haze}"/>
        </DockPanel>

        <Grid Margin="0,22,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="124"/>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid Width="124" Height="124">
            <Ellipse Width="118" Height="118" Stroke="#17FFFFFF" StrokeThickness="21"/>
            <Image x:Name="Ring" Width="124" Height="124" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Ellipse x:Name="Pupil" Width="33" Height="33" Fill="{StaticResource Cloud}" Opacity="0.3"/>
          </Grid>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock x:Name="Headline" Text="Opening up" FontFamily="{StaticResource Display}" FontSize="31"
                       TextWrapping="Wrap" LineHeight="34" LineStackingStrategy="BlockLineHeight"/>
            <TextBlock x:Name="Sub" TextWrapping="Wrap" Foreground="{StaticResource Haze}" Margin="0,8,0,0"
                       LineHeight="20"/>
          </StackPanel>
        </Grid>

        <DockPanel Margin="0,30,0,0">
          <Border DockPanel.Dock="Right" Background="{StaticResource Veil}" CornerRadius="17" Padding="3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="ModeSaved" Content="Saved" Style="{StaticResource Soft}" Width="72"
                      AutomationProperties.Name="Saved browser"/>
              <Button x:Name="ModeFresh" Content="Fresh" Style="{StaticResource Soft}" Width="72"
                      AutomationProperties.Name="Fresh browser"/>
            </StackPanel>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Browser" Foreground="{StaticResource Haze}" FontSize="13"/>
            <TextBlock x:Name="ModeNote" TextWrapping="Wrap" FontSize="13" Margin="0,3,12,0" LineHeight="18"/>
          </StackPanel>
        </DockPanel>
        <Button x:Name="ClearSaved" Content="Clear saved data" Style="{StaticResource Plain}" HorizontalAlignment="Left"
                FontSize="13" Padding="10,5" Margin="-12,4,0,0"/>

        <TextBlock Text="Guests" Foreground="{StaticResource Haze}" FontSize="13" Margin="0,22,0,10"/>
        <StackPanel x:Name="GuestList"/>

        <Border Background="{StaticResource Veil}" CornerRadius="14" Padding="14,4,5,4" Margin="0,2,0,0">
          <DockPanel>
            <Button x:Name="AddGuest" DockPanel.Dock="Right" Content="Add" Style="{StaticResource Soft}" Margin="8,0,0,0"/>
            <Grid>
              <TextBlock x:Name="Placeholder" Text="Add someone by name" Foreground="{StaticResource Haze}"
                         VerticalAlignment="Center" IsHitTestVisible="False"/>
              <TextBox x:Name="NewGuest" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Cloud}"
                       CaretBrush="{StaticResource Cloud}" SelectionBrush="{StaticResource Focus}" Padding="-2,8,0,8"
                       VerticalContentAlignment="Center" MaxLength="24" AutomationProperties.Name="Guest name"/>
            </Grid>
          </DockPanel>
        </Border>
        <TextBlock x:Name="GuestNote" TextWrapping="Wrap" Foreground="{StaticResource Haze}" FontSize="13"
                   Margin="2,10,0,0" LineHeight="19" Visibility="Collapsed"/>

        <Grid Margin="0,28,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="OpenView" Content="Open my view" Style="{StaticResource Main}" IsEnabled="False"/>
          <Button x:Name="EndParty" Grid.Column="2" Content="End party" Style="{StaticResource Plain}"/>
        </Grid>
        <CheckBox x:Name="QuitApps" Content="Also quit Docker and Tailscale when the party ends" Style="{StaticResource Tick}"
                  Margin="0,16,0,0" AutomationProperties.Name="Also quit Docker and Tailscale"/>
      </StackPanel>

      <Grid x:Name="Sheet" Visibility="Collapsed">
        <Border CornerRadius="22" Background="#D9120E30"/>
        <Border VerticalAlignment="Bottom" Margin="14" CornerRadius="18" Background="#30257A" Padding="24,22,24,18">
          <StackPanel>
            <TextBlock Text="End the party too?" FontFamily="{StaticResource Display}" FontSize="24"/>
            <TextBlock x:Name="SheetNote" TextWrapping="Wrap" Foreground="{StaticResource Haze}" Margin="0,8,0,18" LineHeight="20"/>
            <Button x:Name="SheetEnd" Content="End party" Style="{StaticResource Main}"/>
            <Button x:Name="SheetKeep" Content="Keep it running" Style="{StaticResource Soft}" Tag="14" Padding="18,11"
                    FontSize="14" Margin="0,8,0,0"/>
            <Button x:Name="SheetCancel" Content="Cancel" Style="{StaticResource Plain}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
